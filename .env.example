# Local development only. These are public example credentials, not real secrets.
# Copy to .env at the repository root. Never use these credentials in production.
POSTGRES_USER=csrs
POSTGRES_PASSWORD=csrs_local_only
POSTGRES_DB=csrs

CSRS_ENVIRONMENT=local
CSRS_APP_NAME=CSRS
CSRS_LOG_LEVEL=info
CSRS_PUBLIC_ORIGIN=http://localhost:5173

# Host-side Python commands use localhost. Compose overrides these with service DNS.
# If changing the password, URL-encode it in connection URLs.
CSRS_DATABASE_URL=postgresql+psycopg://csrs:csrs_local_only@localhost:5432/csrs
CSRS_REDIS_URL=redis://localhost:6379/0
CSRS_REDIS_NAMESPACE=csrs
CSRS_REDIS_CONNECT_TIMEOUT_SECONDS=0.2
CSRS_REDIS_SOCKET_TIMEOUT_SECONDS=0.2
CSRS_REDIS_MAX_CONNECTIONS=10
CSRS_METADATA_CACHE_ENABLED=true
CSRS_METADATA_CACHE_TTL_SECONDS=15
CSRS_RATE_LIMITS_ENABLED=true
CSRS_RATE_LIMIT_WINDOW_SECONDS=60
CSRS_RATE_LIMIT_BOOTSTRAP=30
CSRS_RATE_LIMIT_AUTH=10
CSRS_RATE_LIMIT_PUBLIC=120
CSRS_RATE_LIMIT_MUTATION=60
CSRS_DB_CONNECT_TIMEOUT_SECONDS=3
CSRS_DB_STATEMENT_TIMEOUT_MS=3000
CSRS_DB_POOL_SIZE=5
CSRS_DB_MAX_OVERFLOW=5
CSRS_ANONYMOUS_SESSION_TTL_SECONDS=900
CSRS_SESSION_TTL_SECONDS=28800
CSRS_HOLD_TTL_SECONDS=300
CSRS_WORKER_POLL_INTERVAL_SECONDS=15
CSRS_WORKER_BATCH_SIZE=100
CSRS_WORKER_RETRY_INITIAL_SECONDS=1
CSRS_WORKER_RETRY_MAX_SECONDS=30

# Opt in to integration tests with a dedicated test database, never the application DB.
# Compose's postgres-test service and CI use this database name.
# CSRS_TEST_DATABASE_URL=postgresql+psycopg://csrs_test:csrs_test_local_only@localhost:5433/csrs_test
# Dedicated disposable Redis test service (database 15); never point at application Redis.
# CSRS_TEST_REDIS_URL=redis://localhost:6380/15
